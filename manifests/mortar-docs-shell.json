{
  "id": "mortar-docs-shell",
  "logicalId": "docs-shell",
  "name": "DocsShell",
  "description": "Mortar documentation docs shell, using central semantic tokens.",
  "stack": "react-tailwind",
  "package": "@tony-ui/mortar",
  "version": "0.1.0",
  "export": "DocsShell",
  "source": "src/docs.tsx",
  "capabilities": ["theme", "docs", "keyboard"],
  "owner": "Mortar maintainers",
  "kitId": "docs",
  "provenance": {
    "kitId": "docs",
    "exampleId": "mortar-docs-reference",
    "sourceDigest": "21815ba555ccc953af98217e48bca375c3e6cf4578cc6cc857597a72ec4306f6"
  },
  "contract": {
    "props": {
      "brand": "string",
      "homeHref": "string",
      "version": "ReactNode",
      "sections": "(LinkAction & { current?: boolean })[]",
      "navigation": "{ title: string; items: NavigationItem[] }[]",
      "toc": "{ id; label; current? }[]",
      "tocLabel": "string",
      "tocFooter": "ReactNode",
      "search": "ReactNode",
      "actions": "ReactNode",
      "children": "ReactNode",
      "layout": "article | wide",
      "navigationLabel": "string"
    },
    "states": [
      "Light",
      "Dark",
      "Neutral brand",
      "Green brand",
      "Keyboard and focus"
    ],
    "usage": "Import { DocsShell } from @tony-ui/mortar. Compose with the public typed props.",
    "avoid": "Do not copy implementations, override central colours or grant component approval.",
    "accessibility": "Verify accessible names, keyboard interaction, visible focus, responsive layout and supported states.",
    "dependencies": ["mortar-button"]
  },
  "preview": {
    "source": "previews/DocsShellPreview.tsx"
  },
  "testing": {
    "profile": "composite",
    "target": ".m-docs-shell",
    "states": [],
    "probe": "navigation"
  },
  "integrity": {
    "source": "9aa20426e3844484d40dee793f56fc2b9acc58c960fae9cd1d0b40c05d14cc79",
