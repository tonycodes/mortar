{
  "name": "@tonycodes-ui/mortar",
  "version": "0.11.0",
  "description": "Mortar: a shared design foundation, application and marketing UI for React and Tailwind.",
  "keywords": [
    "react",
    "tailwind",
    "ui",
    "design-system",
    "components",
    "accessibility",
    "mcp",
    "email"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "catalog.json",
    "baseline-policy.json",
    "design-principles.json",
    "DESIGN.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "TESTING.md",
    "docs/*.md",
    "bin",
    "cli",
    "skills"
  ],
  "bin": {
    "mortar": "./bin/mortar.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "import": "./dist/email.js"
    },
    "./data-grid": {
      "types": "./dist/data-grid.d.ts",
      "import": "./dist/data-grid.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/agent-data.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "catalog": "node scripts/check.mjs --write-catalog",
    "check": "npm run format:check && npm run build && node scripts/check.mjs && node --test tests/*.test.mjs && npm run build:playground",
    "check:json": "node scripts/check.mjs --format json",
    "test:browser": "MORTAR_CONTRACT_FULL=1 playwright test",
    "build:playground": "tsc --noEmit -p tsconfig.playground.json && vite build",
    "format:check": "prettier --check .",
    "release:prepare": "node scripts/release.mjs",
    "test:visual": "playwright test --config playwright.visual.config.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28"
  },
  "peerDependenciesMeta": {
    "@react-email/components": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@~6.0.3",
    "vite": "^8.3.8",
    "@vitejs/plugin-react": "^6.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "@playwright/test": "^1.63.0",
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tonycodes/mortar.git"
  },
  "homepage": "https://mortar.tony.codes/",
  "bugs": {
    "url": "https://github.com/tonycodes/mortar/issues"
  }
}
