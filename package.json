{
  "name": "@tony-ui/mortar",
  "version": "0.1.0",
  "description": "Mortar: a shared design foundation, application and marketing UI for React and Tailwind.",
  "type": "module",
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md",
    "LICENSE",
    "catalog.json",
    "baseline-policy.json",
    "design-principles.json",
    "DESIGN.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "catalog": "node scripts/check.mjs --write-catalog",
    "check": "npm run format:check && npm run build && node scripts/check.mjs && node --test tests/*.test.mjs && npm run build:playground",
    "check:json": "node scripts/check.mjs --format json",
    "test:browser": "playwright test",
    "build:playground": "tsc --noEmit -p tsconfig.playground.json && vite build",
    "format:check": "prettier --check .",
    "release:prepare": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "@playwright/test": "^1.63.0",
    "@axe-core/playwright": "^4.13.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://git.tony.codes/api/packages/tony/npm/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tony.codes/tony/mortar.git"
  },
  "homepage": "https://ui.tony.codes/"
}
